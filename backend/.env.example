# Local default uses SQLite inside backend/adaptive_learning.db
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# demo = no external API needed; groq = real Groq API
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# hash = Python/numpy fallback; sentence_transformers = optional semantic embeddings
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=local

# demo works immediately. trained requires a compatible checkpoint.
DKT_MODE=demo
MODEL_PATH=

MAX_UPLOAD_MB=10
# Add your Vite frontend URL if different.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
